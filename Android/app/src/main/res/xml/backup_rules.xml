<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!-- The Keystore key is not restorable with the encrypted session. -->
        <exclude domain="sharedpref" path="inkwell_oauth_session.xml" />
    </cloud-backup>
    <device-transfer>
        <!-- Never transfer OAuth tokens, refresh state, or DPoP material. -->
        <exclude domain="sharedpref" path="inkwell_oauth_session.xml" />
    </device-transfer>
</data-extraction-rules>
